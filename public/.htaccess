<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Disable directory browsing for security
  Options -Indexes

  # Serve sitemap.xml and robots.txt directly
  RewriteRule ^sitemap\.xml$ sitemap.xml [L]
  RewriteRule ^robots\.txt$ robots.txt [L]

  # 1. Clean URL routing for static-prerendered flat tool pages (e.g. /compress-pdf -> /compress-pdf.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # 2. Clean URL routing for blog posts (e.g. /blog/some-post -> /blog/some-post.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^blog/([^/]+)/?$ blog/$1.html [L]

  # 3. Clean URL routing: if a directory with index.html exists, serve it internally
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 4. Redirect all other requests to index.html if they do not match any existing file or directory (React SPA fallback)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
